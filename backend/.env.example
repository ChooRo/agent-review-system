APP_ENV=development
AUTH_DATA_FILE=./data/auth.json
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_EXPIRE_MINUTES=120
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 独立部署建议使用 8001；本机与采购后端共用 8000 时，可覆盖为 http://[::1]:8000。
MINERU_API_URL=http://127.0.0.1:8001
# 存储后端：json（开发默认）| postgres（生产）。postgres 需先 alembic upgrade head + scripts/backfill_postgres.py。
STORAGE_BACKEND=postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/xiamen_tobacco
# Celery 使用 Redis 作为短期 broker；正式任务状态和审查结论只写 PostgreSQL。
REDIS_URL=redis://127.0.0.1:6379/0
# 留空时回退到 REDIS_URL。
CELERY_BROKER_URL=
CELERY_QUEUE=review
CELERY_TASK_TIME_LIMIT_SECONDS=3600
CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=3300
CELERY_TASK_MAX_RETRIES=3
CELERY_TASK_RETRY_BACKOFF_MAX_SECONDS=600
REVIEW_HEARTBEAT_INTERVAL_SECONDS=30
REVIEW_WORKER_LEASE_SECONDS=180
